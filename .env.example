# ==========================================
# 1. OWNER CONSOLE CREDENTIALS
# ==========================================
# Explicitly configured owner email placeholder (set to your confirmed administrator address)
ADMIN_EMAIL=your-owner-email@domain.com

# 100,000 iterations PBKDF2 SHA-512 hash (generate via ADMIN_AND_FEEDBACK_SETUP.md)
ADMIN_PASSWORD_HASH=

# Cryptographic secrets (Minimum 32 characters in production)
ADMIN_SESSION_SECRET=
IP_HASH_SECRET=

# ==========================================
# 2. REVERSE PROXY & NETWORK SECURITY
# ==========================================
# Set to 'true' when deployed behind trusted reverse-proxy (e.g., Nginx)
TRUST_PROXY=true

# Set to 'true' ONLY if traffic routes through Cloudflare and origin firewall blocks non-Cloudflare traffic
CLOUDFLARE_PROXY=false

# ==========================================
# 3. EMAIL OTP DISPATCH (RESEND)
# ==========================================
RESEND_API_KEY=
OTP_FROM_EMAIL=security@pokefun.in

# ==========================================
# 4. SUPABASE DATABASE & AUTHENTICATION
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# 5. PRIVACY-FIRST TELEMETRY (UMAMI)
# ==========================================
# Client script tracking
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Server-side analytics API credentials (used by admin dashboard)
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
UMAMI_HOST_URL=https://cloud.umami.is
